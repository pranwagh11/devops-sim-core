  "challenges": [
    {
      "id": "seed-challenge-1",
      "lesson_id": "lesson-filesystem",
      "title": "Create Your First Directory",
      "description": "Create a directory called /home/student/backup and a file inside it named data.txt containing the text \"Linux Backup\".",
      "difficulty": "beginner",
      "xp": 10,
      "status": "published",
      "initial_state": {
        "fs": {
          "/": { "type": "dir", "mode": "755" },
          "/home": { "type": "dir", "mode": "755" },
          "/home/student": { "type": "dir", "mode": "755" }
        },
        "users": ["student"],
        "currentUser": "student",
        "services": {},
        "cwd": "/home/student"
      },
      "objectives": [
        { "type": "file_exists", "path": "/home/student/backup" },
        { "type": "file_exists", "path": "/home/student/backup/data.txt" },
        { "type": "file_contains", "path": "/home/student/backup/data.txt", "text": "Linux Backup" }
      ],
      "hints": [
        "Use mkdir to create a directory.",
        "Use echo \"text\" > file to write content into a file."
      ],
      "reference_snapshot": null,
      "created_at": "2026-01-01T00:00:00.000Z",
      "updated_at": "2026-01-01T00:00:00.000Z"
    },
    {
      "id": "seed-challenge-2",
      "lesson_id": "lesson-permissions",
      "title": "Fix File Permissions",
      "description": "A deployment script at /opt/deploy.sh exists but isn't executable. Make it executable (mode 755).",
      "difficulty": "beginner",
      "xp": 15,
      "status": "published",
      "initial_state": {
        "fs": {
          "/": { "type": "dir", "mode": "755" },
          "/opt": { "type": "dir", "mode": "755" },
          "/opt/deploy.sh": { "type": "file", "mode": "644", "content": "#!/bin/bash\necho deploying..." }
        },
        "users": ["student"],
        "currentUser": "student",
        "services": {},
        "cwd": "/opt"
      },
      "objectives": [
        { "type": "permission", "path": "/opt/deploy.sh", "mode": "755" }
      ],
      "hints": ["Use chmod 755 /opt/deploy.sh"],
      "reference_snapshot": null,
      "created_at": "2026-01-01T00:00:00.000Z",
      "updated_at": "2026-01-01T00:00:00.000Z"
    },
    {
      "id": "seed-challenge-3",
      "lesson_id": "lesson-services",
      "title": "Start the Web Server",
      "description": "The nginx service exists but is not running. Start it, then confirm it's active.",
      "difficulty": "beginner",
      "xp": 10,
      "status": "published",
      "initial_state": {
        "fs": { "/": { "type": "dir", "mode": "755" } },
        "users": ["student"],
        "currentUser": "student",
        "services": { "nginx": { "running": false, "port": 80 } },
        "cwd": "/"
      },
      "objectives": [
        { "type": "service_running", "service": "nginx" }
      ],
      "hints": ["Use systemctl start nginx, then systemctl status nginx to confirm."],
      "reference_snapshot": null,
      "created_at": "2026-01-01T00:00:00.000Z",
      "updated_at": "2026-01-01T00:00:00.000Z"
    }
  ],
  "projects": [
    {
      "id": "seed-project-1",
      "lesson_id": "lesson-services",
      "module_id": "module-linux",
      "title": "Three-Tier Web Deployment",
      "description": "Deploy nginx on web01, a backend service on app01, and start the database on db01. Configure networking so web01 can reach app01, and app01 can reach db01.",
      "difficulty": "intermediate",
      "xp": 50,
      "status": "published",
      "hosts": {
        "web01": {
          "fs": {
            "/": { "type": "dir", "mode": "755" },
            "/var": { "type": "dir", "mode": "755" },
            "/var/www": { "type": "dir", "mode": "755" }
          },
          "users": ["student"],
          "currentUser": "student",
          "services": { "nginx": { "running": false, "port": 80 } },
          "cwd": "/"
        },
        "app01": {
          "fs": { "/": { "type": "dir", "mode": "755" } },
          "users": ["student"],
          "currentUser": "student",
          "services": { "backend": { "running": false, "port": 8080 } },
          "cwd": "/"
        },
        "db01": {
          "fs": { "/": { "type": "dir", "mode": "755" } },
          "users": ["student"],
          "currentUser": "student",
          "services": { "postgres": { "running": false, "port": 5432 } },
          "cwd": "/"
        }
      },
      "network_rules": [
        { "from": "web01", "to": "app01", "port": 8080, "allowed": true },
        { "from": "app01", "to": "db01", "port": 5432, "allowed": true }
      ],
      "objectives": [
        { "type": "service_running", "host": "web01", "service": "nginx" },
        { "type": "service_running", "host": "app01", "service": "backend" },
        { "type": "service_running", "host": "db01", "service": "postgres" },
        { "type": "network_reachable", "from": "web01", "to": "app01", "port": 8080 },
        { "type": "network_reachable", "from": "app01", "to": "db01", "port": 5432 }
      ],
      "hints": [
        "Use systemctl start <service> on each host.",
        "Use ssh <hostname> to switch to another host's terminal.",
        "Use curl http://<host>:<port> to test reachability."
      ],
      "reference_snapshot": null,
      "created_at": "2026-01-01T00:00:00.000Z",
      "updated_at": "2026-01-01T00:00:00.000Z"
    }
  ]
}
